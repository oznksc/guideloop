{
  "name": "@guideloop/react",
  "version": "2.0.2",
  "description": "React guided tour library powered by @guideloop/core",
  "author": "Ozan Kesici",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oznksc/guideloop.git",
    "directory": "packages/react"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/esm/builder.js",
      "require": "./dist/cjs/builder.js"
    },
    "./types": {
      "types": "./dist/rsc-types.d.ts",
      "import": "./dist/esm/rsc-types.js",
      "require": "./dist/cjs/rsc-types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && node ../../scripts/run-rollup.mjs -c",
    "dev": "node ../../scripts/run-rollup.mjs -c -w",
    "clean": "rimraf dist",
    "test": "jest --passWithNoTests",
    "lint": "eslint 'src/**/*.{ts,tsx}'"
  },
  "keywords": [
    "react",
    "guide",
    "tour",
    "walkthrough",
    "onboarding",
    "tutorial",
    "product-tour",
    "user-guide",
    "feature-tour"
  ],
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "dependencies": {
    "@guideloop/core": "^2.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "rimraf": "^5.0.0",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "ts-jest": "^29.2.5",
    "tslib": "^2.8.1",
    "typescript": "^4.9.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
