{
  "name": "@guideloop/vanilla",
  "version": "2.0.3",
  "description": "Framework-agnostic guided tour library — imperative API + Web Components powered by @guideloop/core",
  "author": "Ozan Kesici",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oznksc/guideloop.git",
    "directory": "packages/vanilla"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./web-component": {
      "types": "./dist/web-component.d.ts",
      "import": "./dist/esm/web-component.js",
      "require": "./dist/cjs/web-component.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && node ../../scripts/run-rollup.mjs -c",
    "dev": "node ../../scripts/run-rollup.mjs -c -w",
    "clean": "rimraf dist",
    "test": "jest --passWithNoTests",
    "lint": "eslint 'src/**/*.{ts,tsx}'"
  },
  "keywords": [
    "vanilla",
    "javascript",
    "guided-tour",
    "onboarding",
    "walkthrough",
    "web-components",
    "framework-agnostic",
    "product-tour",
    "user-guide"
  ],
  "peerDependencies": {},
  "dependencies": {
    "@guideloop/core": "^2.0.2",
    "@popperjs/core": "^2.11.8"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@testing-library/jest-dom": "^5.17.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "rimraf": "^5.0.0",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.4.1",
    "@rollup/plugin-terser": "^0.4.4",
    "ts-jest": "^29.2.5",
    "tslib": "^2.8.1",
    "typescript": "^4.9.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/esm/web-component.js",
    "./dist/cjs/web-component.js"
  ]
}
