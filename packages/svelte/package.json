{
  "name": "@guideloop/svelte",
  "version": "2.0.3",
  "description": "Svelte guided tour library powered by @guideloop/core and @guideloop/vanilla",
  "author": "Ozan Kesici",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oznksc/guideloop.git",
    "directory": "packages/svelte"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && node ../../scripts/run-rollup.mjs -c && node ./scripts/write-dts.mjs",
    "dev": "node ../../scripts/run-rollup.mjs -c -w",
    "clean": "rimraf dist",
    "test": "jest --passWithNoTests",
    "lint": "eslint 'src/**/*.ts'",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "keywords": [
    "svelte",
    "guided-tour",
    "onboarding",
    "walkthrough",
    "product-tour",
    "user-guide",
    "spotlight"
  ],
  "peerDependencies": {
    "svelte": "^3.59.0 || ^4.0.0 || ^5.0.0"
  },
  "dependencies": {
    "@guideloop/core": "^2.0.2",
    "@guideloop/vanilla": "^2.0.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "rimraf": "^5.0.0",
    "rollup": "^4.62.4",
    "rollup-plugin-svelte": "^7.2.2",
    "svelte": "^4.2.19",
    "svelte-check": "^3.8.6",
    "svelte-jester": "^3.0.0",
    "svelte-preprocess": "^5.1.4",
    "ts-jest": "^29.2.5",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
