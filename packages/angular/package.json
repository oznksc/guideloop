{
  "name": "@guideloop/angular",
  "version": "2.0.2",
  "description": "Angular guided tour library powered by @guideloop/core and @guideloop/vanilla",
  "author": "Ozan Kesici",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oznksc/guideloop.git",
    "directory": "packages/angular"
  },
  "keywords": [
    "angular",
    "guided-tour",
    "onboarding",
    "walkthrough",
    "product-tour",
    "user-guide",
    "spotlight"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && ng-packagr -p ng-package.json && node ./scripts/fix-dist-pkg.mjs",
    "clean": "rimraf dist",
    "test": "jest --passWithNoTests",
    "lint": "eslint 'src/**/*.ts'"
  },
  "peerDependencies": {
    "@angular/common": ">=15.0.0",
    "@angular/core": ">=15.0.0"
  },
  "dependencies": {
    "@guideloop/core": "^2.0.2",
    "@guideloop/vanilla": "^2.0.2",
    "tslib": "^2.6.3"
  },
  "devDependencies": {
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/compiler-cli": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ng-packagr": "^17.3.0",
    "rimraf": "^5.0.10",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.2.5",
    "typescript": "~5.4.5",
    "zone.js": "^0.14.10"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
