{
  "name": "@guideloop/core",
  "version": "2.0.2",
  "description": "Framework-agnostic guided tour core logic",
  "author": "Ozan Kesici",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oznksc/guideloop.git",
    "directory": "packages/core"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && node ../../scripts/run-rollup.mjs -c",
    "dev": "node ../../scripts/run-rollup.mjs -c -w",
    "clean": "rimraf dist",
    "test": "jest --passWithNoTests",
    "lint": "eslint 'src/**/*.{ts,tsx}'"
  },
  "keywords": [
    "guided-tour",
    "onboarding",
    "framework-agnostic",
    "core"
  ],
  "peerDependencies": {},
  "dependencies": {
    "@popperjs/core": "^2.11.8"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@rollup/plugin-typescript": "^8.5.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "rimraf": "^5.0.0",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.4.1",
    "ts-jest": "^29.2.5",
    "tslib": "^2.8.1",
    "typescript": "^4.9.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
